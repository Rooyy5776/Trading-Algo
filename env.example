# Copy to .env and `export $(cat .env | xargs)` before running, or set these
# directly in your shell / systemd unit / AWS task definition. Every value
# has a safe default baked into delta_data_pipeline.py — you only need to
# set what you want to change.

# REST/WS hosts — see the "SOURCE VERIFICATION" block at the top of
# delta_data_pipeline.py before ever changing these.
DELTA_REST_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange

# Universe
DELTA_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,BNBUSD
DELTA_TIMEFRAMES=1m,5m,15m,1h
DELTA_LOOKBACK_DAYS=60

# Where everything gets written (section 10 layout is created under this)
DELTA_DATA_DIR=delta_dataset

# Networking behaviour
DELTA_REQUEST_TIMEOUT_SEC=15
DELTA_MAX_RETRIES=5
DELTA_INTER_REQUEST_SLEEP_SEC=0.2

# No API key or secret is read by this file anywhere — it only touches
# PUBLIC market-data endpoints. Do not put trading keys in this file.
